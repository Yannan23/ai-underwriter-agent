%%{init: {"theme":"base","flowchart":{"curve":"basis","htmlLabels":true,"nodeSpacing":30,"rankSpacing":50},"themeVariables":{"fontFamily":"Inter, Arial, sans-serif","fontSize":"14px","primaryColor":"#EEF4FF","primaryTextColor":"#172033","primaryBorderColor":"#5790FF","lineColor":"#68758A","secondaryColor":"#EBF9F3","tertiaryColor":"#FFF7E7","clusterBkg":"#FFFFFF","clusterBorder":"#CBD5E1"}}}%%
flowchart TB

    %% Interview story: entry -> durable analysis -> deterministic decision -> bind
    Users["Broker · Underwriter · Admin"] --> FE["FE<br/>REST · upload · realtime"]
    FE --> Entry["Edge + Identity<br/>CDN / WAF · OAuth/OIDC · API Gateway"]
    Entry --> Core["Core API<br/>modular monolith<br/>AuthZ · validation · domain policies"]

    Core -->|immutable submission<br/>+ evaluation ID| Orchestrator

    subgraph ANALYSIS["DURABLE, BOUNDED ANALYSIS"]
        direction TB
        Orchestrator["EventBridge → Step Functions → SQS / DLQ<br/>versioned workflow · retries · timeout · callback"]

        subgraph TASKS["Parallel typed tasks"]
            direction LR
            Documents["Document Processing<br/>scan · OCR · evidence · conflicts"]
            External["External Checks<br/>registry · claims · compliance"]
            AI["Controlled AI Underwriter<br/>read-only tools · RAG citations<br/>schema + safety validation"]
            Policies["Rules + Pricing<br/>deterministic eligibility · premium · authority"]
        end

        Orchestrator --> Documents
        Orchestrator --> External
        Orchestrator --> AI
        Orchestrator --> Policies
    end

    Documents --> Gate
    External --> Gate
    AI --> Gate
    Policies --> Gate

    Gate["Deterministic Decision + Authority Gate<br/>AI cannot approve, price or bind"]

    Gate -->|all gates pass| AutoQuote["AUTO_QUOTE"]
    Gate -->|uncertainty / authority| Human["HUMAN REVIEW<br/>override reason · maker-checker"]
    Gate -->|missing info / dependency| RFI["RFI / OPERATIONAL HOLD"]

    AutoQuote --> Quote["Immutable Quote Version"]
    Human --> Quote
    Quote --> Accept["Exact Quote Acceptance"]
    Accept --> Binding["Independent Binding Workflow<br/>idempotent request · reconcile unknown outcome"]
    RFI -. "new information → new immutable version" .-> Core

    subgraph DATA["BUSINESS DATA & APPROVED KNOWLEDGE"]
        direction LR
        Aurora[("Aurora PostgreSQL<br/>business source of truth")]
        S3[("S3<br/>quarantine · originals · artifacts")]
        Search[("OpenSearch<br/>approved versioned KB index")]
    end

    Core --> Aurora
    Documents --> S3
    AI -. "tenant/product-scoped retrieval" .-> Search

    subgraph SERVICES["APPROVED SERVICES"]
        direction LR
        Models["Bedrock Models<br/>pinned model / prompt policy"]
        Providers["Registry / Claims / Compliance"]
        PAS["Policy Administration System"]
    end

    AI --> Models
    External --> Providers
    Binding --> PAS

    Controls["PRODUCTION GUARANTEES<br/>Immutable versions · Outbox + idempotency · IAM/KMS/RLS · audit + telemetry<br/>Multi-AZ + warm standby · RPO ≤ 5 min · RTO ≤ 1 hour"]
    Controls -. applies to .-> Core
    Controls -. applies to .-> Orchestrator
    Controls -. applies to .-> Aurora

    Interview["INTERVIEW ANCHOR<br/>Keep transactional invariants in the modular monolith;<br/>isolate slow and failure-prone work with managed workflows."]
    Interview -. rationale .-> Core

