# Copy to .env and fill in — never commit real keys.
# Each worktree needs its own copy: cp .env ../auw-<name>/.env

# ── Runtime ──────────────────────────────────────────────────────────────
# true  = all model calls replaced by typed fixtures (offline demo / CI / integration tests)
# false = real Anthropic + Voyage calls (requires the API keys below)
MOCK_MODE=true
PORT=3000
# Pause between stages in ms — makes the demo progress view animate (mock mode defaults to 350)
STAGE_DELAY_MS=

# ── Model APIs (required when MOCK_MODE=false) ───────────────────────────
# Anthropic — Stage 1 extraction/classification (Haiku), Stage 5/6 reasoning (Sonnet)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Voyage AI — Stage 4 guideline retrieval embeddings (+ rerank later)
# https://dash.voyageai.com/api-keys
VOYAGE_API_KEY=

# Optional overrides — defaults are pinned in code and recorded per decision
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5
# ANTHROPIC_MODEL_REASONING=claude-sonnet-5

# ── Day 2+ (not used yet — uncomment when the feature lands) ─────────────
# Supabase — persistence, pgvector, object storage (PRD §7; Sydney region)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# Sentry — exception aggregation (PRD §12 alerting)
# SENTRY_DSN=
